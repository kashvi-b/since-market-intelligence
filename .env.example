# Postgres (docker compose up -d db)
DATABASE_URL=postgresql://since:since@localhost:5544/since

# Investigation agent. The product is fully functional without a key — changes
# are still detected, scored and explained by the deterministic engine, which is
# the default path rather than a degraded one.
#
# Gemini, because its free tier means the investigation does not depend on a
# paid account. Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
AGENT_PROVIDER=gemini
AGENT_MODEL=gemini-3.5-flash,gemini-3.7-flash,gemini-3.1-flash-lite

# The agent is provider-neutral (see DECISIONS.md #17). To use Claude instead,
# uncomment these and set AGENT_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5

# Market data ingestion. Used by the one-shot ingest CLI only; never called on
# the demo path.
#
# Yahoo's unofficial endpoint rate-limits by IP and has been observed blocking
# entire Indian mobile carrier ranges. Twelve Data is the reliable alternative:
# a free key allows 800 requests/day, and a full 51-symbol ingest needs ~102.
#   https://twelvedata.com/pricing
TWELVEDATA_API_KEY=

# auto (default) prefers twelvedata when a key is present, else yahoo.
# Force one with: npm run ingest -- --provider twelvedata|yahoo|synthetic
INGEST_PROVIDER=auto
